FLASK_APP=run.py
FLASK_ENV=production
APP_SECRET_KEY=replace-with-a-long-random-secret
STORAGE_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-sb-publishable-key
SUPABASE_SECRET_KEY=replace-with-sb-secret-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
IWOWN_REGION=global
IWOWN_API_HOST=https://euapi.iwown.com
IWOWN_ALGO_HOST=https://iwap1.iwown.com/algoservice
IWOWN_API_ACCOUNT=
IWOWN_API_PASSWORD=
DASHBOARD_AUTH_TOKEN=
LOG_LEVEL=INFO
LOG_DIR=logs
UPLOAD_BASE_PATH=4g
